# Copiar a `.env` (raíz del repo) y completar. NUNCA commitear `.env`.
# Se inyecta en la app con: flutter run --dart-define-from-file=../.env
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
# URL pública de la micro-app (GitHub Pages)
MICROAPP_URL=https://<usuario>.github.io/<repo>/
# Habilita el panel chaos fuera de debug (true/false)
ENABLE_CHAOS_PANEL=false
